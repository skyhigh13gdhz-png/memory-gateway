# Memory Gateway 自身监听
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Hindsight 可以与 Gateway 同机，也可以部署在另一台服务器。
# 同机推荐使用 loopback；分机时改为受保护的 HTTPS/私网地址。
HINDSIGHT_BASE_URL=http://127.0.0.1:8888

# 不要在这里填写真实 token；真实值只写入服务器本地 .env。
GATEWAY_API_TOKEN=replace-me-locally

# 第一阶段默认 bank，仅用于开发/部署验收；后续由身份与 bank policy 接管。
DEFAULT_BANK_ID=default

# Retain 幂等账本。自动指纹只在短窗口内去重；显式 idempotency_key 长期有效。
IDEMPOTENCY_DB_PATH=/var/lib/memory-gateway/idempotency.sqlite3
IDEMPOTENCY_AUTOMATIC_WINDOW_SECONDS=900
